<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.steve.smartsheet-runner</string>

  <key>ProgramArguments</key>
  <array>
    <!-- Use the SAME python interpreter that runs the existing 4:30pm
         export_plans.py job (check the working launchd job / `which python3`).
         The poller re-invokes export_plans.py via sys.executable, so this
         interpreter must be the one that has its dependencies. -->
    <string>/usr/bin/python3</string>
    <string>/Users/steve/scripts/run_export_queue.py</string>
  </array>

  <!-- Check the on-demand queue every 60s (and once at login). -->
  <key>StartInterval</key>
  <integer>60</integer>

  <key>RunAtLoad</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/Users/steve/Library/Logs/smartsheet-runner.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/steve/Library/Logs/smartsheet-runner.log</string>
</dict>
</plist>
